                continue
                
            print("生成中...")
            poem = self.generate_poem(prompt, max_len=40, temperature=0.7)
            print(f"\n生成结果:")
            print(f"提示: '{prompt}'")
            print(f"诗词: {poem}")
            print("-" * 30)

def format_poem_display(poem, line_length=8):
